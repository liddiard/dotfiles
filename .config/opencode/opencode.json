{
  "$schema": "https://opencode.ai/config.json",

  // Prompt the user for permission before executing any bash/shell commands.
  // Other tools (read, edit, etc.) are left at their defaults.
  "permission": {
    "bash": "ask"
  },

  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"]
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@upstash/context7-opencode"
  ]
}
